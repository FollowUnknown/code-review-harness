# Server
PORT=3006
REVIEW_TIMEOUT_MINUTES=30

# LLM Provider
LLM_PROVIDER=anthropic
ANTHROPIC_AUTH_TOKEN=your-token
ANTHROPIC_BASE_URL=https://open.bigmodel.cn/api/anthropic
ANTHROPIC_MODEL=glm-5.1
DEEPSEEK_API_KEY=

# GitLab
GITLAB_HOST=https://gitlab.example.com
GITLAB_TOKEN=your-gitlab-token

# Lanhu (optional)
LANHU_TOKEN=
LANHU_BASE_URL=https://api.lanhu.com

# Database path (recommended for test environment)
KNOWLEDGE_DB_PATH=/absolute/path/to/knowledge.db
SOURCE_DB_PATH=/absolute/path/to/local/knowledge.db
TARGET_DB_PATH=/absolute/path/to/test-env/knowledge.db

# Dev only
VITE_PORT=5173
