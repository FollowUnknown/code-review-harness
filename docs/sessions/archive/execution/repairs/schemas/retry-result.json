{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "execution-repair-retry-result",
  "title": "ExecutionRepairRetryResult",
  "description": "Final result after repair cycle retry",
  "type": "object",
  "required": ["repairId", "runId", "timestamp", "result", "retryCount"],
  "properties": {
    "repairId": {
      "type": "string",
      "pattern": "^repair-\\d{8}-\\d{3}$"
    },
    "runId": {
      "type": "string"
    },
    "timestamp": {
      "type": "number"
    },
    "result": {
      "type": "string",
      "enum": ["passed", "failed", "partial"],
      "description": "Final result after repair: passed=all issues fixed, failed=issues remain, partial=some fixed"
    },
    "retryCount": {
      "type": "number",
      "description": "Number of repair iterations attempted"
    },
    "remainingIssues": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "level": { "type": "string", "enum": ["critical", "high", "medium", "low"] },
          "type": { "type": "string" },
          "message": { "type": "string" }
        }
      },
      "description": "Issues that could not be resolved"
    },
    "resolvedIssues": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Issue types that were successfully resolved"
    }
  }
}
