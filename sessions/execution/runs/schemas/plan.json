{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "execution-run-plan",
  "title": "ExecutionRunPlan",
  "description": "RED phase evidence - Plan stage of an Execution Run",
  "type": "object",
  "required": ["runId", "contractId", "phase", "agentType", "timestamp", "content", "extractedForMemory"],
  "properties": {
    "runId": {
      "type": "string",
      "pattern": "^run-\\d{8}-\\d{3}$",
      "description": "Unique run identifier, e.g. run-20260428-001"
    },
    "contractId": {
      "type": "string",
      "description": "Associated contract ID"
    },
    "phase": {
      "type": "string",
      "const": "plan",
      "description": "Always 'plan' for this schema"
    },
    "agentType": {
      "type": "string",
      "enum": ["planner", "generator", "evaluator"],
      "description": "Which agent produced this plan"
    },
    "timestamp": {
      "type": "number",
      "description": "Unix timestamp in milliseconds"
    },
    "content": {
      "type": "object",
      "required": ["scope", "approach"],
      "properties": {
        "scope": {
          "type": "string",
          "description": "What this run covers"
        },
        "approach": {
          "type": "string",
          "description": "Planned approach"
        },
        "risks": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Identified risks"
        },
        "decisions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["decision", "rationale"],
            "properties": {
              "decision": { "type": "string" },
              "rationale": { "type": "string" }
            }
          },
          "description": "Key decisions made during planning"
        },
        "filesAffected": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Files that will be affected"
        },
        "gradingCriteria": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Criteria for evaluating this run"
        }
      }
    },
    "extractedForMemory": {
      "type": "boolean",
      "default": false,
      "description": "Phase 4 pre-embedding: whether this record has been extracted for task memory"
    }
  }
}
